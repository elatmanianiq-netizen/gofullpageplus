# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill it in. `.env` is gitignored.
#
#   cp .env.example .env
#
# Vite loads this file for both `pnpm dev` and `pnpm build`. Only variables
# prefixed with VITE_ are exposed to the browser; everything else stays on the
# server, which is exactly where ADMIN_TOKEN must remain.
# ─────────────────────────────────────────────────────────────────────────────

# ── Support inbox access (required to use /admin) ─────────────────────────────
# The password for the support inbox at /admin. Must be at least 16 characters;
# the admin routes refuse to work rather than open up if it is missing or short.
#
# Generate a strong one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Treat it like a production password: anyone holding it can read every message
# users have sent you. Do not commit it, and do not paste it into a chat.
ADMIN_TOKEN=T1SyYNrR9lIBXM_DRnV06ecb_bUOUnPx5GbkngHJMQo

# ── Optional: new-ticket notifications ───────────────────────────────────────
# An HTTPS endpoint you control (Slack or Discord incoming webhook, Zapier, your
# own service). When set, a short summary is POSTed there as tickets arrive, so
# you do not have to poll /admin.
#
# Only the reference code, category, and subject are sent. The message body is
# deliberately withheld so a third-party webhook does not become a copy of every
# user's support history.
# SUPPORT_WEBHOOK_URL=

# ── Optional: storage and retention ──────────────────────────────────────────
# Where support tickets are written. Defaults to ./data next to package.json.
# Point this at a persistent volume if your host has an ephemeral filesystem,
# otherwise tickets are lost on every redeploy.
# SUPPORT_DATA_DIR=./data

# Days to keep support tickets before automatic deletion. Defaults to 365.
# Keep this in step with `supportRetentionDays` in client/src/site-config.ts,
# because that value is what the Privacy Policy promises users.
# SUPPORT_RETENTION_DAYS=365

# ── Optional: server ─────────────────────────────────────────────────────────
# Port for `pnpm start` in production. Defaults to 3000.
# PORT=3000

# ── Optional: privacy-friendly analytics ─────────────────────────────────────
# Consumed by client/index.html. Leave both blank to ship no analytics at all,
# which is the simplest position to defend in a privacy policy.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
