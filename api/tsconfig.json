{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../.vercel/output",
    "rootDir": "..",
    "baseUrl": "..",
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../shared/**/*.ts"]
}
