# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill it in. `.env` is gitignored.
#
#   cp .env.example .env
#
# Vite loads this file for both `pnpm dev` and `pnpm build`. Only variables
# prefixed with VITE_ are exposed to the browser; everything else stays on the
# server. On Vercel, set these under Settings → Environment Variables instead.
# ─────────────────────────────────────────────────────────────────────────────

# ── Support email delivery (SMTP) ─────────────────────────────────────────────
# Support form submissions are emailed to you over SMTP. Set these and every
# message users send from /support lands in your inbox; replying goes straight
# back to them (their address is set as Reply-To).
#
# SMTP_HOST   Your mail provider's SMTP server.
# SMTP_PORT   465 for SSL, or 587 for STARTTLS. Defaults to 587.
# SMTP_USER   Your SMTP login (usually your full email address).
# SMTP_PASS   Your SMTP password. For Gmail/Google Workspace this must be an
#             "App Password" (generated at myaccount.google.com/apppasswords),
#             not your normal account password.
# SMTP_FROM   The From address shown on the email. Defaults to SMTP_USER.
# SUPPORT_TO  Where tickets are delivered. Defaults to SMTP_USER.
#
# Example for Gmail / Google Workspace:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=you@gofullpageplus.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM=you@gofullpageplus.com
#   SUPPORT_TO=you@gofullpageplus.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPPORT_TO=

# ── Optional: server ─────────────────────────────────────────────────────────
# Port for `pnpm start` in production. Defaults to 3000.
# PORT=3000

# ── Optional: privacy-friendly analytics ─────────────────────────────────────
# Consumed by client/index.html. Leave both blank to ship no analytics at all,
# which is the simplest position to defend in a privacy policy.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
